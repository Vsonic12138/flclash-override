# 复制为服务器 /opt/dgc/runtime.env 后填写占位符；不要提交真实配置。
# Docker --env-file 不去除引号；值不要加引号。
HOST=127.0.0.1
PORT=13200
BASE_URL=https://REPLACE_BASE_HOST/REPLACE_PRIVATE_SUBSCRIPTION
SOURCES=赔钱机场=http://127.0.0.1:13000/REPLACE_BACKEND_PATH/download/collection/merge;酷狗=http://127.0.0.1:13000/REPLACE_BACKEND_PATH/download/%E9%85%B7%E7%8B%97
OPTIONAL_SOURCES=TAGMeta=http://127.0.0.1:13000/REPLACE_BACKEND_PATH/download/TAGMeta
SECRET=/REPLACE_PRIVATE_DOWNLOAD_PATH
UA=clash-verge/v2.4.2
CACHE_TTL=300
LAST_GOOD_DIR=/app/data
FILENAME=大狗叫订阅.yaml
BASE_SOURCE_LABEL=赔钱机场
# 下行分隔符前后各一个空格，末尾空格属于值。
NODE_LABEL_SEPARATOR= · 
SIMPLIFY_GROUPS=true
USAGE_GROUPS=true
AUTO_BACKUP=true
UNIFIED_RULES=true
AD_GROUP_ENABLED=true
AI_RESIDENTIAL_ONLY=true
DAILY_DATACENTER_ONLY=true
AI_AUTO_FALLBACK=true
AI_REGION=美国
AI_ALLOWED_REGIONS=美国;日本;马来西亚
AI_AUTO_REGION=美国
AI_MAX_MULTIPLIER=6
AI_RESIDENTIAL_KEYWORDS=DMIT2;美国|家宽|Wave;TAGMeta · 🇺🇸 美国-家宽 01;TAGMeta · 🇺🇸 美国-家宽 02;TAGMeta · 🇯🇵 日本家宽;TAGMeta · 🇲🇾 马来西亚家宽
